{
  "name": "@near/near-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "predev": "node scripts/gen-routes.mjs",
    "postinstall": "prisma generate --schema=./packages/cms-core/prisma/schema.prisma",
    "build": "next build",
    "prebuild": "node scripts/gen-routes.mjs && pnpm run lint:page-meta && pnpm run lint:typography",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:routes": "node scripts/gen-routes.mjs",
    "routes:check": "node scripts/gen-routes.mjs --check",
    "lint": "eslint . --config eslint.config.mjs --no-config-lookup",
    "lint:page-meta": "eslint \"app/**/page.meta.ts\" --config eslint.config.mjs --no-config-lookup --max-warnings=0",
    "lint:typography": "node scripts/check-typography.mjs",
    "prisma:migrate": "prisma migrate dev --schema=./packages/cms-core/prisma/schema.prisma",
    "prisma:seed": "node packages/cms-core/prisma/seed.ts",
    "prisma:studio": "prisma studio --schema=./packages/cms-core/prisma/schema.prisma"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@near/cms-core": "workspace:*",
    "@siteping/adapter-prisma": "0.6.4",
    "@siteping/dashboard": "0.2.5",
    "@siteping/widget": "0.10.7",
    "feed": "^4.2.2",
    "geist": "^1.7.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.576.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.0.0",
    "unicornstudio-react": "^2.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.8",
    "shadcn": "^3.8.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
