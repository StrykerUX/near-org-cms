generator client {
  provider      = "prisma-client-js"
  output        = "../../../node_modules/.prisma/client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  name            String
  role            Role     @default(EDITOR)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastLoginAt     DateTime?
  pages           Page[]   @relation("PageAuthor")
  lastEditedPages Page[]   @relation("PageLastEditor")
  posts           Post[]   @relation("PostAuthor")
  lastEditedPosts Post[]   @relation("PostLastEditor")
  banners         Banner[] @relation("BannerAuthor")
  linktrees       Linktree[] @relation("LinktreeOwner")
}

model Post {
  id                 String     @id @default(cuid())
  title              String
  slug               String     @unique
  content            Json
  excerpt            String?
  coverImage         String?
  status             Status     @default(DRAFT)
  seoTitle           String?
  seoDesc            String?
  ogImage            String?
  authorId           String
  publishedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  heroBgColor        String?
  heroBgImage        String?
  lastEditedById     String?
  lockedAt           DateTime?
  lockedBy           String?
  lockedByEmail      String?
  previewPassword    String?
  previewToken       String?    @unique
  excludeFromSitemap Boolean    @default(false)
  author             User       @relation("PostAuthor", fields: [authorId], references: [id])
  lastEditedBy       User?      @relation("PostLastEditor", fields: [lastEditedById], references: [id])
  categories         Category[] @relation("CategoryToPost")
  tags               Tag[]      @relation("PostToTag")
}

model Page {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  content          Json
  status           Status   @default(DRAFT)
  seoTitle         String?
  seoDesc          String?
  ogImage          String?
  authorId         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lastEditedById   String?
  publishedAt      DateTime?
  excludeFromSitemap Boolean @default(false)
  author           User     @relation("PageAuthor", fields: [authorId], references: [id])
  lastEditedBy     User?    @relation("PageLastEditor", fields: [lastEditedById], references: [id])
}

model Banner {
  id                 String            @id @default(cuid())
  name               String
  type               BannerType        @default(TOP)
  paths              String[]          @default([])
  enabled            Boolean           @default(false)
  frequency          BannerFrequency   @default(ALWAYS)
  contentMode        BannerContentMode @default(HTML)
  content            Json?
  htmlContent        String?
  modalDelaySeconds  Int?
  modalScrollPercent Int?
  modalPosition      BannerModalPosition @default(CENTER)
  displayMode        BannerDisplayMode @default(OVERLAY)
  startDate          DateTime?
  endDate            DateTime?
  viewCount          Int               @default(0)
  clickCount         Int               @default(0)
  dismissCount       Int               @default(0)
  authorId           String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  author             User              @relation("BannerAuthor", fields: [authorId], references: [id])

  @@index([enabled])
}

model Media {
  id        String   @id @default(cuid())
  url       String
  filename  String
  mimeType  String
  size      Int
  alt       String?
  slug      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[] @relation("CategoryToPost")
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[] @relation("PostToTag")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model InvitationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  name      String
  role      Role     @default(EDITOR)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  data      Json
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([formId])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  userEmail   String
  action      String
  entityType  String
  entityId    String
  entityTitle String
  createdAt   DateTime @default(now())
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BannerType {
  TOP
  MODAL
  BOTTOM
}

enum BannerFrequency {
  ALWAYS
  ONCE_PER_SESSION
  DONT_SHOW_AGAIN
}

enum BannerContentMode {
  EDITOR
  HTML
}

enum BannerModalPosition {
  TOP_LEFT
  TOP_CENTER
  TOP_RIGHT
  CENTER_LEFT
  CENTER
  CENTER_RIGHT
  BOTTOM_LEFT
  BOTTOM_CENTER
  BOTTOM_RIGHT
}

enum BannerDisplayMode {
  OVERLAY
  PUSH
}

model Linktree {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  displayName     String?
  bio             String?
  avatarUrl       String?
  bgColor         String?   @default("#0A0A0A")
  bgImage         String?
  textColor       String?   @default("#FFFFFF")
  buttonBgColor   String?   @default("#FFFFFF")
  buttonTextColor String?   @default("#0A0A0A")
  overlayColor    String?   @default("#000000")
  overlayOpacity  Int?      @default(0)
  overlayColor2   String?   @default("#000000")
  overlayOpacity2 Int?      @default(0)
  glassEffect     Boolean   @default(false)
  sectionTitleBold   Boolean @default(true)
  sectionTitleItalic Boolean @default(false)
  buttonTextBold     Boolean @default(false)
  buttonTextItalic   Boolean @default(false)
  titleFontSize   LinktreeTitleSize @default(MD)
  showTitle       Boolean   @default(true)
  avatarSize      LinktreeTitleSize @default(SM)
  avatarShape     LinktreeAvatarShape @default(CIRCLE)
  seoTitle        String?
  seoDesc         String?
  ogImage         String?
  status          Status    @default(DRAFT)
  ownerId         String
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  owner           User               @relation("LinktreeOwner", fields: [ownerId], references: [id])
  sections        LinktreeSection[]
  links           LinktreeLink[]
}

model LinktreeSection {
  id          String   @id @default(cuid())
  linktreeId  String
  title       String
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  displayType LinktreeSectionDisplayType @default(COLUMN)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  linktree    Linktree @relation(fields: [linktreeId], references: [id], onDelete: Cascade)
  links       LinktreeLink[]

  @@index([linktreeId])
}

model LinktreeLink {
  id          String    @id @default(cuid())
  linktreeId  String
  sectionId   String?
  title       String
  url         String
  icon        String?
  position    Int       @default(0)
  isActive    Boolean   @default(true)
  forwardUtm  Boolean   @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  clickCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  linktree    Linktree         @relation(fields: [linktreeId], references: [id], onDelete: Cascade)
  section     LinktreeSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  clicks      LinktreeClick[]
  utmPresets  LinktreeUtmPreset[]

  @@index([linktreeId])
  @@index([sectionId])
}

model LinktreeClick {
  id          String   @id @default(cuid())
  linkId      String
  clickedAt   DateTime @default(now())
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  referrer    String?
  deviceType  String?
  browser     String?
  os          String?
  ipHash      String?
  isBot       Boolean  @default(false)
  link        LinktreeLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, clickedAt])
}

model LinktreeUtmPreset {
  id          String   @id @default(cuid())
  linkId      String
  label       String
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  createdById String?
  createdAt   DateTime @default(now())
  link        LinktreeLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
}

enum LinktreeSectionDisplayType {
  COLUMN
  ROW
  ICONS
  ICONS_LABEL
}

enum LinktreeTitleSize {
  SM
  MD
  LG
}

enum LinktreeAvatarShape {
  CIRCLE
  LOGO
}

// ── SitePing ─────────────────────────────────────────────────────────────────
// Anotaciones de revisión del sitio (feedback visual del equipo sobre staging o
// producción). Los define @siteping/adapter-prisma y su forma NO es negociable:
// el handler consulta estos campos por nombre. Si se actualiza el paquete, hay
// que revisar su changelog antes de migrar.
//
// Viven acá y no en un schema aparte porque Prisma genera un solo cliente por
// datasource, y partirlo obligaría a un segundo PrismaClient con su propio pool
// de conexiones — caro para dos tablas. Son autónomas: no tienen ninguna
// relación con User ni con nada del CMS, así que se pueden borrar de una pieza
// el día que se retire la herramienta.
model SitepingFeedback {
  id               String               @id @default(cuid())
  projectName      String
  type             String
  message          String               @db.Text
  status           String               @default("open")
  url              String
  urlPattern       String?
  screenshotUrl    String?              @db.Text
  screenshotRegion Json?
  diagnostics      Json?
  viewport         String
  userAgent        String
  authorName       String
  authorEmail      String
  clientId         String               @unique
  resolvedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  annotations      SitepingAnnotation[]

  @@index([projectName])
  @@index([projectName, status, createdAt])
  @@index([projectName, url])
}

// El ancla de cada comentario. Guarda la MISMA posición de cinco formas
// (selector, xpath, texto y vecinos, huella, porcentajes) a propósito: si el
// layout cambia y el selector deja de resolver, el widget reancla por texto o
// por porcentaje en vez de perder el comentario.
model SitepingAnnotation {
  id               String           @id @default(cuid())
  feedbackId       String
  feedback         SitepingFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  cssSelector      String           @db.Text
  xpath            String           @db.Text
  textSnippet      String           @db.Text
  elementTag       String
  elementId        String?
  textPrefix       String           @db.Text
  textSuffix       String           @db.Text
  fingerprint      String
  neighborText     String           @db.Text
  anchorKey        String?
  xPct             Float
  yPct             Float
  wPct             Float
  hPct             Float
  scrollX          Float
  scrollY          Float
  viewportW        Int
  viewportH        Int
  devicePixelRatio Float            @default(1)
  createdAt        DateTime         @default(now())

  @@index([feedbackId])
}
